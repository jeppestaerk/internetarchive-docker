# Copy to .env and fill in. Every value here is optional.
#
# Without credentials the container still works for public downloads,
# metadata and search - it just cannot upload, delete or read restricted items.

# archive.org S3-like API keys, from https://archive.org/account/s3.php
# Set BOTH or NEITHER: setting only one makes the library raise a ValueError.
#
# You can skip these entirely and log in with the CLI instead, which also stores
# your logged-in-* session cookies (these keys do not):
#
#   docker compose run --rm ia configure
#
# That writes to /config/ia.ini in the ia-config volume and persists.
IA_ACCESS_KEY_ID=
IA_SECRET_ACCESS_KEY=

# Ownership of downloaded files. Match your host user: id -u / id -g
PUID=1000
PGID=1000

TZ=Europe/Copenhagen
