{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "UTC",
  "schedule": [
    "before 4am on Monday"
  ],
  "labels": [
    "dependencies"
  ],
  "automerge": true,
  "platformAutomerge": true,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "ARG BASE_VERSION=(?<currentValue>.*?)\\nARG BASE_DIGEST=(?<currentDigest>sha256:[a-f0-9]+)\\n"
      ],
      "depNameTemplate": "python",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "ARG IA_VERSION=(?<currentValue>.*?)\\n"
      ],
      "depNameTemplate": "internetarchive",
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "python"
      ],
      "groupName": "Python Alpine"
    },
    {
      "matchDatasources": [
        "pypi"
      ],
      "matchPackageNames": [
        "internetarchive"
      ],
      "groupName": "internetarchive"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Security updates should not wait for the weekly window",
      "matchUpdateTypes": [
        "patch"
      ],
      "matchDatasources": [
        "docker"
      ],
      "schedule": [
        "at any time"
      ]
    }
  ],
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ],
    "schedule": [
      "at any time"
    ]
  },
  "osvVulnerabilityAlerts": true
}
